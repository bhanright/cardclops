<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: back up and transfer only the user's own database (the collection, decks, price
     history). Card data, images and the unpacked web page are rebuildable and live in
     noBackupFilesDir, which is never backed up. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="cardclops/cardclops.sqlite" />
        <!-- Writes since SQLite last folded its journal in live here; without it a backup misses them. -->
        <include domain="file" path="cardclops/cardclops.sqlite-wal" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="cardclops/" />
    </device-transfer>
</data-extraction-rules>
